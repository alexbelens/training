{
  "name": "training",
  "version": "0.3.6",
  "description": "Self-hosted дневник тренировок с авто-прогрессией и тренером-Claude",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbelens/training"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
