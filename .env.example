# Порт на хосте (в контейнере всегда 8080)
PORT=8080
# Публичный адрес сервиса — используется в ссылках для сброса пароля
PUBLIC_URL=http://192.168.1.10:8080
# Токен тренера (Claude Code ходит в API с ним). Сгенерировать: openssl rand -hex 24
COACH_TOKEN=
# Код приглашения при регистрации (пусто — регистрация без кода)
INVITE_CODE=
# Почта для восстановления пароля (необязательно). Пример: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM=training@example.com
# Ставь 1, если сервис за HTTPS
SECURE_COOKIE=0
# Часовой пояс для ночных бэкапов
TZ=Europe/Kyiv
# Сколько ночных бэкапов хранить
BACKUP_KEEP=14
# Cloudflare Tunnel (публичный адрес). Токен из Zero Trust → Networks → Tunnels. В туннеле: Public hostname → http://training:8080
TUNNEL_TOKEN=
